# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Data & models — never commit raw datasets or weights (root dirs only:
# an unanchored pattern would also swallow src/detector/data and src/detector/models)
/data/
/models/
*.ckpt
*.safetensors
*.pt

# Notebooks: keep outputs out of diffs where possible
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# gitignore model checkpoints inside results
results/runs/*/model/
